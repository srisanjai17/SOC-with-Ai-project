# ═══════════════════════════════════════════════════════════════════
# SOC with AI — Environment Configuration
# Copy to .env and customize for production
# ═══════════════════════════════════════════════════════════════════

# ── Authentication ──────────────────────────────────────────────
# Admin password (REQUIRED in production — do NOT use default)
SOC_ADMIN_PASSWORD=your_strong_password_here

# ── HTTPS (set to 1 to enable secure cookies) ─────────────────
SOC_HTTPS=0

# ── Admin Mode (set to 1 when running with elevated privileges)
SOC_ADMIN_MODE=0

# ── Database ────────────────────────────────────────────────────
# Default: SQLite (data/soc.db) — no configuration needed
# For PostgreSQL production deployment, set this:
# SOC_DB_URL=postgresql://soc_user:password@localhost:5432/soc_db

# ── Logging ─────────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Network Capture ─────────────────────────────────────────────
# Capture interface (leave empty for auto-detect)
# SOC_CAPTURE_INTERFACE=WiFi
